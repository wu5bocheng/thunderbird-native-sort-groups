{
  "manifest_version": 2,
  "name": "__MSG_addonName__",
  "version": "0.4.0",
  "description": "__MSG_addonDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "native-date-domain-groups@local.invalid",
      "strict_min_version": "158.0",
      "strict_max_version": "158.*"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "__MSG_toggleGrouping__",
    "default_icon": "icons/icon.svg"
  },
  "experiment_apis": {
    "nativeGroups": {
      "schema": "native/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["nativeGroups"]],
        "script": "native/implementation.js"
      }
    }
  },
  "default_locale": "en",
  "author": "wu5bocheng",
  "homepage_url": "https://github.com/wu5bocheng/thunderbird-native-sort-groups",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
